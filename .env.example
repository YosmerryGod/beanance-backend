NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./storage/beanance.sqlite

# Use a random secret with at least 32 characters in production.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# OAuth 2.0 Web Client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# SMTP settings for sending email verification codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Beanance <no-reply@example.com>
